<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View - Danh sách chứng thư số -->
    <record id="view_digital_certificate_tree" model="ir.ui.view">
        <field name="name">om.digital.certificate.tree</field>
        <field name="model">om.digital.certificate</field>
        <field name="arch" type="xml">
            <tree string="Chứng thư số" decoration-danger="is_active==False">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="certificate_serial"/>
                <field name="certificate_type"/>
                <field name="issuer"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="signature_count"/>
            </tree>
        </field>
    </record>

    <!-- Form View - Form chứng thư số -->
    <record id="view_digital_certificate_form" model="ir.ui.view">
        <field name="name">om.digital.certificate.form</field>
        <field name="model">om.digital.certificate</field>
        <field name="arch" type="xml">
            <form string="Chứng thư số" class="modern-form">
                <sheet>
                    <!-- Section: Just the Essentials -->
                    <div class="oe_title">
                        <h2>Thông tin cơ bản</h2>
                        <p class="text-muted">Đây là tất cả các trường thông tin cơ bản cho một chứng thư số mới. Nếu bạn muốn thêm chi tiết, bạn có thể dễ dàng truy cập chúng bên dưới hoặc qua điều hướng bên.</p>
                    </div>
                    
                    <group>
                        <group>
                            <field name="name" placeholder="Nhập tên chứng thư số..."/>
                            <field name="employee_id" placeholder="Chọn nhân viên..." required="1" options="{'no_create': True}"/>
                            <field name="certificate_serial" placeholder="Nhập số seri chứng thư..."/>
                            <field name="certificate_type" placeholder="Chọn loại chứng thư..."/>
                        </group>
                        <group>
                            <field name="issuer" placeholder="Nhập tổ chức cấp..."/>
                            <field name="issue_date" placeholder="Chọn ngày cấp"/>
                            <field name="expiry_date" placeholder="Chọn ngày hết hạn"/>
                            <field name="is_active" readonly="1"/>
                            <field name="signature_count" readonly="1" placeholder="Số lần sử dụng"/>
                        </group>
                    </group>
                    <group>
                        <field name="certificate_file" filename="certificate_filename" widget="binary"/>
                        <field name="certificate_filename" invisible="1"/>
                    </group>
                    <group>
                        <field name="notes" placeholder="Nhập ghi chú về chứng thư số..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_digital_certificate_search" model="ir.ui.view">
        <field name="name">om.digital.certificate.search</field>
        <field name="model">om.digital.certificate</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm chứng thư số">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="certificate_serial"/>
                <field name="issuer"/>
                <filter string="Đang hoạt động" name="active" domain="[('is_active', '=', True)]"/>
                <filter string="Hết hạn" name="expired" domain="[('is_active', '=', False)]"/>
            </search>
        </field>
    </record>
</odoo>

