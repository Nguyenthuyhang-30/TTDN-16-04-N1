<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View - Danh sách loại văn bản -->
    <record id="view_document_type_tree" model="ir.ui.view">
        <field name="name">om.document.type.tree</field>
        <field name="model">om.document.type</field>
        <field name="arch" type="xml">
            <tree string="Loại văn bản">
                <field name="code" string="Mã"/>
                <field name="name" string="Tên loại văn bản"/>
                <field name="incoming_count" string="Văn bản đến"/>
                <field name="outgoing_count" string="Văn bản đi"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form View - Form loại văn bản -->
    <record id="view_document_type_form" model="ir.ui.view">
        <field name="name">om.document.type.form</field>
        <field name="model">om.document.type</field>
        <field name="arch" type="xml">
            <form string="Loại văn bản" class="modern-form">
                <sheet>
                    <!-- Section: Just the Essentials -->
                    <div class="oe_title">
                        <h2>Thông tin cơ bản</h2>
                        <p class="text-muted">Đây là tất cả các trường thông tin cơ bản cho một loại văn bản mới. Nếu bạn muốn thêm chi tiết, bạn có thể dễ dàng truy cập chúng bên dưới hoặc qua điều hướng bên.</p>
                    </div>
                    
                    <group>
                        <group>
                            <field name="code" placeholder="Nhập mã loại văn bản..."/>
                            <field name="name" placeholder="Nhập tên loại văn bản..."/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mô tả" name="description">
                            <field name="description" placeholder="Nhập mô tả về loại văn bản..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_document_type_search" model="ir.ui.view">
        <field name="name">om.document.type.search</field>
        <field name="model">om.document.type</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm loại văn bản">
                <field name="name"/>
                <field name="code"/>
                <filter string="Hoạt động" name="active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>
</odoo>

