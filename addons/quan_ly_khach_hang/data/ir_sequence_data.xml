<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence cho mã đơn hàng -->
    <record id="seq_order_code" model="ir.sequence">
        <field name="name">Mã đơn hàng</field>
        <field name="code">qlkh.order.code</field>
        <field name="prefix">DHH</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="number_next">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

