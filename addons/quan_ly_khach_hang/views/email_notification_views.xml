<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View - Danh sách email -->
    <record id="view_email_notification_tree" model="ir.ui.view">
        <field name="name">qlkh.email.notification.tree</field>
        <field name="model">qlkh.email.notification</field>
        <field name="arch" type="xml">
            <tree string="Email và thông báo" decoration-success="state == 'sent'" decoration-danger="state == 'failed'">
                <field name="subject" string="Chủ đề"/>
                <field name="recipient_emails" string="Người nhận" readonly="1"/>
                <field name="state" string="Trạng thái" widget="badge"/>
                <field name="sent_date" string="Ngày gửi"/>
            </tree>
        </field>
    </record>

    <!-- Form View - Form email -->
    <record id="view_email_notification_form" model="ir.ui.view">
        <field name="name">qlkh.email.notification.form</field>
        <field name="model">qlkh.email.notification</field>
        <field name="arch" type="xml">
            <form string="Email và thông báo" class="modern-form">
                <header>
                    <field name="state" invisible="1"/>
                    <button name="action_send" string="Gửi email" type="object" class="oe_highlight" invisible="state == 'sent'"/>
                    <button name="action_reset_to_draft" string="Quay lại nháp" type="object" invisible="state != 'sent'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent" statusbar_clickable="1"/>
                </header>
                <sheet>
                    <!-- Section: Just the Essentials -->
                    <div class="oe_title">
                        <h2>Thông tin cơ bản</h2>
                        <p class="text-muted">Đây là tất cả các trường thông tin cơ bản cho một email mới. Nếu bạn muốn thêm chi tiết, bạn có thể dễ dàng truy cập chúng bên dưới hoặc qua điều hướng bên.</p>
                    </div>
                    
                    <group>
                        <group>
                            <field name="subject" placeholder="Nhập chủ đề email..."/>
                            <field name="recipient_ids" widget="many2many_tags" placeholder="Chọn người nhận..." options="{'no_create': True}"/>
                            <field name="recipient_emails" readonly="1" invisible="not recipient_emails" placeholder="Danh sách email người nhận"/>
                        </group>
                        <group>
                            <field name="sent_date" readonly="1" placeholder="Ngày gửi"/>
                        </group>
                    </group>
                    <group string="Nội dung email">
                        <field name="body" placeholder="Nhập nội dung email..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View - Tìm kiếm email -->
    <record id="view_email_notification_search" model="ir.ui.view">
        <field name="name">qlkh.email.notification.search</field>
        <field name="model">qlkh.email.notification</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm email">
                <field name="subject" string="Chủ đề"/>
                <field name="recipient_ids" string="Người nhận"/>
                <filter string="Nháp" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Đã gửi" name="sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Gửi thất bại" name="failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter string="Hôm nay" name="today" domain="[('sent_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('sent_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
            </search>
        </field>
    </record>

    <!-- Action để mở danh sách email -->
    <record id="action_email_notification" model="ir.actions.act_window">
        <field name="name">Gửi và Quản lý Email</field>
        <field name="res_model">qlkh.email.notification</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo email đầu tiên
            </p>
            <p>
                Gửi email và thông báo đến khách hàng.
            </p>
        </field>
    </record>

</odoo>

